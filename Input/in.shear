read_restart	restart.100000
change_box	all triclinic units box
# -----------Force fields:Define interaction potential-----------
pair_style      sw
pair_coeff      * * borophene.sw B1 B2 B3 B4 B5 B6 B7 B8

## Store equilibrated dimensions
variable        tmp equal lx
variable        L0 equal ${tmp}
variable        tmp1 equal ly
variable        L1 equal ${tmp1}
variable        tmp2 equal lz
variable        L2 equal ${tmp2}


compute          st all stress/atom NULL
compute          stave all reduce sum c_st[1] c_st[2] c_st[3] c_st[4] c_st[5] c_st[6]
variable         vol equal lx*ly*lz
#Normalize stress components:
variable          n1all  equal c_stave[1]/v_vol
variable          n2all  equal c_stave[2]/v_vol
variable          n3all  equal c_stave[3]/v_vol
variable          n4all  equal c_stave[4]/v_vol
variable          n5all  equal c_stave[5]/v_vol
variable          n6all  equal c_stave[6]/v_vol

variable          s1all  equal "v_n1all*lz*0.00001"
variable          s2all  equal "v_n2all*lz*0.00001"
variable          s3all  equal "v_n3all*lz*0.00001"
variable          s4all  equal "v_n4all*lz*0.00001"
variable          s5all  equal "v_n5all*lz*0.00001"
variable          s6all  equal "v_n6all*lz*0.00001"



# Define variables to store strain values and timestep
variable        strainx equal "(lx-v_L0)/v_L0"
variable        strainy equal "(ly-v_L1)/v_L1"
variable        strainz equal "(lz-v_L2)/v_L2"
variable        step1 equal step
variable        lzz equal lz
variable	p2 equal "-(0.001*pxx)*(lz*0.1)"



timestep	0.001
fix		1 all deform 1 xy erate -0.001 units box 
fix 		2 all nvt  temp 1.0 1.0 0.1 

fix def1 all print 100  "${step1} ${strainx} ${strainy} ${strainz} ${s1all} ${s2all} ${s3all} ${s4all} ${s5all} ${s6all} ${n1all} ${lzz} ${p2}" file Tension_Boro_1K.txt screen no title "#Timestep exx eyy ezz sxx syy szz sxy sxz syz sxx1 lz pxx"
dump		1 all custom 5000 dump.* id type x y z
thermo		100
thermo_style	custom step temp press atoms pxx pyy pzz lx ly lz
thermo_modify	lost warn 
restart         20000 restart
run		3000000
